# .env.example — Copy to .env and customize for your deployment.
#
# See README.md for full documentation of all supported variables.
# Only variables you want to override need to be set here.

# ── Network ────────────────────────────────────────────────────────────────
FRONTEND_BIND_IP=0.0.0.0
FRONTEND_PUBLIC_ADDRESS=fes.mhserveremu.localdev
WEBFRONTEND_ADDRESS=*

# PostgreSQL preview values are used only with docker-compose.postgresql.yaml.
# Do not add credentials to this file.
# POSTGRES_DB=mhserveremu
# POSTGRES_USER=mhserveremu
# POSTGRESQL_CONNECTION_STRING=
# POSTGRESQL_CONNECTION_STRING_FILE=/run/secrets/postgresql-connection-string

# ── Game Options ───────────────────────────────────────────────────────────
# CUSTOMGAMEOPTIONS_AUTO_UNLOCK_AVATARS=true
# CUSTOMGAMEOPTIONS_AUTO_UNLOCK_TEAMUPS=true
# GAMEDATA_LOAD_ALL_PROTOTYPES=false

# ── Store ──────────────────────────────────────────────────────────────────
# MTXSTORE_GAZILLIONITE_BALANCE_FOR_NEW_ACCOUNTS=10000
# MTXSTORE_HOME_PAGE_URL=http://localhost/store
